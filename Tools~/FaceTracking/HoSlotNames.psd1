# HoSlotNames.psd1 -- 叶子 Direct 树的名字表（唯一来源）
#
# 谁用：make-vts-controller.ps1（生成时给叶子树起名）+ check-controller.ps1（核槽位名）。
# 为什么单开一份：名字是"词"，逻辑是"代码" —— 改词只改这里，两边同时生效（不再各抄一份）。
#
# 规则（2026-09-28 用户定）：
#   · 只有**最下游的 Direct 树**（叶子树，表的孩子）用这套中文名；表名 / 区域名 / 根名 / **clip 名一律不动**；
#   · 不带轴、不带索引：一个词自带"哪儿的什么状态"；
#   · "词本身没说部位"时才加部位前缀（嘴型/眼睑那两族）；眼睑分左右 ⇒ 用「左眼/右眼」保证全局唯一；
#   · **全局唯一**：这些名字是片段/Motion 的显示名，两处同名就撞 ⇒ 生成时断言。
#
# 键 = 表名（生成器里的树名），值 = 按**格序**列的名字：
#   2D 表：外层 i（X 轴刻度，从低到高），内层 j（Y 轴刻度，从低到高）—— 和 SlotKids 的双层 for 同序；
#   1D 表：按刻度数组顺序；
#   Direct 表：按 cells 数组顺序。
# 空字符串 = 那一格物理上到不了（生成器本来就不给它建片段），不需要名字。
@{
    # 2D：X = FormSmile {-1, 0, 0.75, 1}（苦/平/笑/大笑）· Y = OpenMeasured {0, 0.4, 0.75}（闭/半张/张满）
    # ⚠️ 4×3 = 12 个位置，生成器挖掉其中一格 ⇒ 没被挖的那些才真生成；这里按格序把词给全。
    MouthCore = @(
        @('嘴苦闭',   '嘴苦半张', '嘴苦满'),
        @('嘴平闭',   '嘴平半张', '嘴平满'),
        @('嘴笑闭',   '嘴笑半张', '嘴笑满'),
        @('嘴大笑闭', '嘴大笑半张', '嘴大笑满')
    )

    # 变体（猫嘴版）：格子与稀疏和 MouthCore 完全相同，只是整套姿势换成猫嘴 ⇒ 名字给一套「猫嘴」前缀的
    MouthCoreRoll = @(
        @('猫嘴苦闭',   '猫嘴苦半张', '猫嘴苦满'),
        @('猫嘴平闭',   '猫嘴平半张', '猫嘴平满'),
        @('猫嘴笑闭',   '猫嘴笑半张', '猫嘴笑满'),
        @('猫嘴大笑闭', '猫嘴大笑半张', '猫嘴大笑满')
    )

    # 2D：X = ±0.6/0（嘴左移/嘴中位/嘴右移）· Y = 0/+1（下/上）
    # ⭐ 2026-09-29 用户定：**上排左右两格复用同侧下排的片段**（同一个名字写两次 = 同一份叶子树 / 同一份片段）。
    #    为什么：旧的 T 形挖掉那两个上角 ⇒ 凸包是**三角形**，上排两侧的查询点被投影到斜边上 ⇒ 只能得到
    #    「左⊕上 / 右⊕上」的混合，而且**越往上横移的有效量被斜边挤得越小**。补上这两格（名字相同 ⇒ 片段相同）
    #    之后凸包是**矩形** ⇒ 左右两列在任意高度都是纯横移；想再收成"金字塔"就把上排那两点往内拉（坐标由用户手调）。
    #    ⚠️ 同名不是错误：Unity 里一个混合树的孩子只是「动作 + 坐标 + 阈值」，两个格子指向同一个动作完全合法；
    #       槽位片段数**不变**（不新建片段），只是树里多两个孩子。
    # ⚠️ 左右**保持原样**（2026-09-28 用户确认：嘴平移本来就是对的，我上一轮按"观众视角"改反了，已改回）：
    #    X = −0.6 叫「嘴左移」、X = +0.6 叫「嘴右移」，与 profile 里 `Mouth/X` 的「+ 往左」一致。
    MouthShift = @(
        @('嘴左移', '嘴左移'),
        @('嘴中位', '嘴上移'),
        @('嘴右移', '嘴右移')
    )

    # 2D：X = 左颊鼓 · Y = 右颊鼓，刻度各 **{0, 0.39, 0.65}**（2026-09-29 用户手调定稿）
    #   0   = 颊不动（小月牙**藏在脸里**）
    #   0.39 = 小月牙**挪出来**（表里「开」那一档；⭐ 轴曲线在它之前是平的、**0.40 处瞬跳到 0.39**，见 profile 那两行的 notes）
    #   0.65 = 月牙被**移动**满档（0.39 以上连续；原来写 1.0，用户手调收到 0.65 ⇒「移动」来得更早）
    # ⚠️ **双鼓那一格是手调的 `(0.6, 0.6)`** —— 不在刻度值上（单侧满档 0.65）⇒ 生成器走 `over`、
    #    检查器走 `$exactPos['颊双鼓']`、构建器走 `CheekPuffOverride`，三处同一组值。
    # ⚠️ 3×3 里只摆 7 格：`(1,2)` 与 `(2,1)`（一侧「移动」另一侧「才出来」）**先不建** —— 落到那里会被凸包投影成邻居的混合；
    #    哪天真看到那个组合再加（加格子不改名：槽位名按索引编）。
    Cheek = @(
        @('颊常',     '鼓嘴右开', '颊右鼓'),
        @('鼓嘴左开', '鼓嘴双开', ''),
        @('颊左鼓',   '',         '颊双鼓')
    )

    # 1D
    # 2D（T 形 4 格，两个「合×左右」的角到不了，靠混合）：X = JawSide(−0.52/0/0.52) · Y = Jaw(0/0.75)
    # ⚠️ 左右用**第三人称（观众视角）**：轴值是 ARKit 原始符号（负端 = ARKit 的 jawLeft = 模型的左 = 观众右）
    #    ⇒ X = −0.52 那格是「下巴右」，X = +0.52 是「下巴左」（不加"张"：那两格是左右，不是张嘴）。
    MouthJaw = @(
        @('',       '下巴右'),
        @('下巴合', '下巴张'),
        @('',       '下巴左')
    )
    MouthWidth  = @('嘴缩', '嘴常', '嘴宽')
    MouthTongue = @('舌常', '舌伸1', '舌伸2', '舌伸满')
    InvertedV   = @('噘嘴关', '噘嘴开')
    NoseUp      = @('鼻常', '鼻顶')

    # Direct 11 格（顺序 = 生成器/检查器里 DirectTables 的 Cells 顺序）—— 眼睑分左右
    LidL = @('左眼中性闭', '左眼中性睁', '左眼中性睁大', '左眼喜闭', '左眼喜睁',
             '左眼怒闭', '左眼怒睁', '左眼怒睁大', '左眼悲闭', '左眼悲睁', '左眼悲睁大')
    LidR = @('右眼中性闭', '右眼中性睁', '右眼中性睁大', '右眼喜闭', '右眼喜睁',
             '右眼怒闭', '右眼怒睁', '右眼怒睁大', '右眼悲闭', '右眼悲睁', '右眼悲睁大')
}
