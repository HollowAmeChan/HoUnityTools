# HoSlotNames.psd1 -- 叶子 Direct 树的名字表（唯一来源）
#
# 谁用：make-vts-controller.ps1（生成时给叶子树起名）+ check-controller.ps1（核槽位名）。
# 为什么单开一份：名字是"词"，逻辑是"代码" —— 改词只改这里，两边同时生效（不再各抄一份）。
#
# 规则（2026-09-28 用户定）：
#   · 只有**最下游的 Direct 树**（叶子树，表的孩子）用这套中文名；表名 / 区域名 / 根名 / **clip 名一律不动**；
#   · 不带轴、不带索引：一个词自带"哪儿的什么状态"；
#   · "词本身没说部位"时才加部位前缀（嘴型/眼睑那两族）；眼睑分左右 ⇒ 用「左眼/右眼」保证全局唯一；
#   · **全局唯一**：这些名字是片段/Motion 的显示名，两处同名就撞 ⇒ 生成时断言。
#
# 键 = 表名（生成器里的树名），值 = 按**格序**列的名字：
#   2D 表：外层 i（X 轴刻度，从低到高），内层 j（Y 轴刻度，从低到高）—— 和 SlotKids 的双层 for 同序；
#   1D 表：按刻度数组顺序；
#   Direct 表：按 cells 数组顺序。
# 空字符串 = 那一格物理上到不了（生成器本来就不给它建片段），不需要名字。
@{
    # 2D：X = FormSmile {-1, 0, 0.75, 1}（苦/平/笑/大笑）· Y = OpenMeasured {0, 0.4, 0.75}（闭/半张/张满）
    # ⚠️ 4×3 = 12 个位置，生成器挖掉其中一格 ⇒ 没被挖的那些才真生成；这里按格序把词给全。
    MouthCore = @(
        @('嘴苦闭',   '嘴苦半张', '嘴苦满'),
        @('嘴平闭',   '嘴平半张', '嘴平满'),
        @('嘴笑闭',   '嘴笑半张', '嘴笑满'),
        @('嘴大笑闭', '嘴大笑半张', '嘴大笑满')
    )

    # 2D：X = ±0.95/0（嘴左移/嘴中位/嘴右移）· Y = 0/+1（下/上）—— 两个上角到不了
    MouthShift = @(
        @('嘴左移', ''),
        @('嘴中位', '嘴上移'),
        @('嘴右移', '')
    )

    # 2D：X = 左颊鼓 {0, 1} · Y = 右颊鼓 {0, 1}
    Cheek = @(
        @('颊常',   '颊右鼓'),
        @('颊左鼓', '颊双鼓')
    )

    # 1D
    MouthJaw    = @('下巴合', '下巴张')
    MouthWidth  = @('嘴缩', '嘴常', '嘴宽')
    MouthTongue = @('舌常', '舌伸1', '舌伸2', '舌伸满')
    InvertedV   = @('噘嘴关', '噘嘴开')
    NoseUp      = @('鼻常', '鼻顶')

    # Direct 11 格（顺序 = 生成器/检查器里 DirectTables 的 Cells 顺序）—— 眼睑分左右
    LidL = @('左眼中性闭', '左眼中性睁', '左眼中性睁大', '左眼喜闭', '左眼喜睁',
             '左眼怒闭', '左眼怒睁', '左眼怒睁大', '左眼悲闭', '左眼悲睁', '左眼悲睁大')
    LidR = @('右眼中性闭', '右眼中性睁', '右眼中性睁大', '右眼喜闭', '右眼喜睁',
             '右眼怒闭', '右眼怒睁', '右眼怒睁大', '右眼悲闭', '右眼悲睁', '右眼悲睁大')
}
