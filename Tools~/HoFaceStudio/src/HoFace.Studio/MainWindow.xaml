<Window x:Class="HoFace.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HoFace.Studio"
    Title="HoFaceStudio" Width="1380" Height="860" MinWidth="1024" MinHeight="640"
    WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
    Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" Icon="Assets/hoface-studio.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf"/>
    <HierarchicalDataTemplate x:Key="IrTreeItemTemplate" DataType="{x:Type local:IrTreeItem}"
        ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
          <TextBlock.Style><Style TargetType="TextBlock">
            <Style.Triggers><DataTrigger Binding="{Binding IsOverridden}" Value="True">
              <Setter Property="Foreground" Value="#E9B578"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="覆盖" FontSize="10" Foreground="#E9B578" Margin="6,0,0,0"
            Visibility="{Binding IsOverridden, Converter={StaticResource VisibleIf}}"/>
        <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
      </StackPanel>
    </HierarchicalDataTemplate>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="MonitorParameterTemplate" DataType="{x:Type local:MonitorParameterRow}">
      <Border x:Name="MeterCard" Width="184" Height="26" Margin="2,2" Background="{StaticResource RaisedBrush}"
          BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="3" ToolTip="{Binding DetailText}">
        <Grid x:Name="MeterArea" Margin="2,0" Background="Transparent">
          <ProgressBar x:Name="Meter" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=OneWay}"
              Background="{StaticResource InputBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"
              IsHitTestVisible="False" Focusable="False"/>
          <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0.5" CornerRadius="2"
              IsHitTestVisible="False"/>
          <Grid x:Name="MeterReadout" Margin="6,0" IsHitTestVisible="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="10"/>
            <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="10" FontWeight="SemiBold" Margin="6,0,0,0"/>
          </Grid>
          <StackPanel x:Name="OverrideActions" Orientation="Horizontal" HorizontalAlignment="Right"
              Background="{StaticResource RaisedBrush}" Visibility="Collapsed">
            <Button Content="×" Tag="auto" Click="SetMonitorOverrideClicked" Padding="4,0" MinWidth="22" Margin="1,0"
                FontSize="10" ToolTip="恢复实时输入" AutomationProperties.Name="恢复实时输入"/>
            <Button Content="−1" Tag="-1" Click="SetMonitorOverrideClicked" Padding="4,0" MinWidth="28" Margin="1,0"
                FontSize="10" ToolTip="临时覆盖为 -1" AutomationProperties.Name="临时覆盖为负一"/>
            <Button Content="0" Tag="0" Click="SetMonitorOverrideClicked" Padding="4,0" MinWidth="23" Margin="1,0"
                FontSize="10" ToolTip="临时覆盖为 0" AutomationProperties.Name="临时覆盖为零"/>
            <Button Content="1" Tag="1" Click="SetMonitorOverrideClicked" Padding="4,0" MinWidth="23" Margin="1,0"
                FontSize="10" ToolTip="临时覆盖为 1" AutomationProperties.Name="临时覆盖为正一"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="MeterArea" Property="IsMouseOver" Value="True">
          <Setter TargetName="OverrideActions" Property="Visibility" Value="Visible"/>
          <Setter TargetName="MeterReadout" Property="Visibility" Value="Collapsed"/>
        </Trigger>
        <Trigger SourceName="MeterCard" Property="IsMouseOver" Value="True">
          <Setter TargetName="MeterCard" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsOverridden}" Value="True">
          <Setter TargetName="MeterCard" Property="BorderBrush" Value="#E9B578"/>
          <Setter TargetName="Meter" Property="Foreground" Value="#E9B578"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Open" Executed="OpenExecuted"/>
    <CommandBinding Command="ApplicationCommands.Save" Executed="SaveExecuted" CanExecute="SaveCanExecute"/>
    <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoExecuted" CanExecute="UndoCanExecute"/>
    <CommandBinding Command="ApplicationCommands.Redo" Executed="RedoExecuted" CanExecute="RedoCanExecute"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.Open" Modifiers="Control" Key="O"/>
    <KeyBinding Command="ApplicationCommands.Save" Modifiers="Control" Key="S"/>
    <KeyBinding Command="ApplicationCommands.Undo" Modifiers="Control" Key="Z"/>
    <KeyBinding Command="ApplicationCommands.Redo" Modifiers="Control" Key="Y"/>
    <KeyBinding Command="ApplicationCommands.Redo" Modifiers="Control+Shift" Key="Z"/>
  </Window.InputBindings>
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="HoFaceStudio" FontSize="15" FontWeight="SemiBold" Margin="0,0,22,0"/>
          <Button Content="打开" Command="ApplicationCommands.Open" ToolTip="打开一对 value + IR 文件 · Ctrl+O"/>
          <Button Content="保存" Command="ApplicationCommands.Save" ToolTip="保存作品 · Ctrl+S"/>
          <Button Content="撤销" Command="ApplicationCommands.Undo" ToolTip="撤销一次编辑，保持当前选择 · Ctrl+Z"/>
          <Button Content="重做" Command="ApplicationCommands.Redo" ToolTip="重做 · Ctrl+Y / Ctrl+Shift+Z"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,16,0">
          <TextBlock Text="{Binding DocumentName}" MaxWidth="230" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValuePath}"/>
          <TextBlock Text="{Binding HeaderStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0"/>
        </StackPanel>
        <ToggleButton Grid.Column="2" Content="作品文件" IsChecked="{Binding ShowFiles}" ToolTip="查看路径，或分别选择 value 与 IR 文件"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid Margin="16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Mode}" SelectionChanged="ModeChanged"
              ToolTip="Blender：外部求值并发送最终权重。Unity：只转发原始输入，由 Unity 自行求值。">
            <ComboBoxItem Tag="Preview">Blender · 权重预览</ComboBoxItem>
            <ComboBoxItem Tag="RawForward">Unity · 原始输入</ComboBoxItem>
          </ComboBox>
          <Button Grid.Column="1" Content="{Binding ConnectionAction}" Click="ConnectionToggleClicked" Margin="12,0,7,0"
              IsEnabled="{Binding CanConnect}" ToolTip="Preview 模式需先打开作品；RawForward 模式可无作品接收并转发 VTS 原始输入"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="{Binding PreviewAction}" Click="PreviewToggleClicked" IsEnabled="{Binding CanPreview}"
                ToolTip="启停发往 Blender 的最终权重；仅在 Blender 模式可用"/>
            <ToggleButton x:Name="ManualOverrideToggle" Content="{Binding ManualPreviewAction}" IsChecked="{Binding ManualPreviewEnabled, Mode=TwoWay}"
                IsEnabled="{Binding CanPreview}" Padding="7,3" Margin="6,0,0,0"
                ToolTip="打开后在曲线或混合图中点击、拖动进行临时覆盖；关闭立即恢复实时值">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                  <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value></Setter>
                  <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter Property="Foreground" Value="#E9B578"/>
                      <Setter Property="BorderBrush" Value="#E9B578"/>
                      <Setter Property="Background" Value="#392E24"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
            <Button Content="恢复实时" Click="ClearManualPreviewClicked" Visibility="{Binding HasManualPreview, Converter={StaticResource VisibleIf}}"
                ToolTip="取消临时参数覆盖；未连接实时输入时释放预览权重"/>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding LiveStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"
              Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputStatus}"/>
          <ToggleButton Grid.Column="4" Content="连接与回放" IsChecked="{Binding ShowConnection}" ToolTip="手机地址、端口、录制与回放设置"/>
        </Grid>
        <Border Visibility="{Binding ShowFiles, Converter={StaticResource VisibleIf}}" Padding="16,4,16,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="value" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="ValueFilePathBox" Grid.Column="1" Text="{Binding ValueFilePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding ValueFilePath}"/>
            <Button x:Name="BrowseValueFileButton" Grid.Column="2" Content="浏览…" Click="BrowseValueFileClicked" Margin="8,0,0,0"
                ToolTip="打开文件选择窗口，选择 value JSON 并填写路径" AutomationProperties.Name="选择 Value JSON 文件"/>
            <TextBlock Grid.Row="1" Text="IR" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            <TextBox x:Name="IrFilePathBox" Grid.Row="1" Grid.Column="1" Text="{Binding IrFilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" ToolTip="{Binding IrFilePath}"/>
            <Button x:Name="BrowseIrFileButton" Grid.Row="1" Grid.Column="2" Content="浏览…" Click="BrowseIrFileClicked" Margin="8,6,0,0"
                ToolTip="打开文件选择窗口，选择 IR JSON 并填写路径" AutomationProperties.Name="选择 IR JSON 文件"/>
          </Grid>
        </Border>
        <Border Visibility="{Binding ShowConnection, Converter={StaticResource VisibleIf}}" Padding="16,4,16,12">
          <StackPanel>
            <WrapPanel>
              <TextBlock Text="手机 IP" Margin="0,0,8,0"/>
              <TextBox Width="145" Text="{Binding PhoneIp, UpdateSourceTrigger=PropertyChanged}" ToolTip="运行 VTS iPhone 的手机局域网 IPv4 地址"/>
              <TextBlock Text="手机端口" Margin="16,0,8,0"/>
              <TextBox Width="75" Text="{Binding PhonePort, UpdateSourceTrigger=PropertyChanged}" ToolTip="手机 VTS 监听端口，默认 21412"/>
              <TextBlock Text="本机端口" Margin="16,0,8,0"/>
              <TextBox Width="75" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="本机接收端口，默认 21413；需与其他接收器错开"/>
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="{Binding RecordAction}" Click="RecordToggleClicked" IsEnabled="{Binding CanRecord}" ToolTip="将 VTS 原始输入记录为 JSONL；RawForward 模式无需打开作品"/>
              <Button Content="打开录制" Click="OpenReplayClicked" IsEnabled="{Binding CanUseReplay}" ToolTip="选择本地 JSONL 原始帧录制"/>
              <Button Content="{Binding ReplayAction}" Click="ReplayToggleClicked" IsEnabled="{Binding ReplayLoaded}" ToolTip="播放或暂停已打开的录制；权重预览需先打开作品"/>
              <TextBlock Text="{Binding RecordingStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <Grid x:Name="Workspace" Grid.Row="2" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="StructureColumn" Width="240" MinWidth="180" MaxWidth="500"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition x:Name="PlotColumn" Width="0.95*" MinWidth="280"/>
        <ColumnDefinition x:Name="EditorSplitterColumn" Width="8"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="1.05*" MinWidth="320"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="5">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="作品结构" FontWeight="SemiBold" Margin="14,12,14,9"/>
          <TabControl Grid.Row="1" SelectedIndex="{Binding StructureTab}" BorderThickness="0">
            <TabItem Header="Value" ToolTip="输入处理后的输出参数与响应曲线">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox Margin="6,4,6,9" Tag="筛选参数…" Text="{Binding ValueFilter, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="筛选 Value 参数" ToolTip="筛选参数名称或表达式；筛选不会清除当前编辑项"/>
                <ListBox Grid.Row="1" x:Name="ValueList" ItemsSource="{Binding ValueRows}" SelectedItem="{Binding SelectedValueRow}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel ToolTip="{Binding Display}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock">
                          <Style.Triggers><DataTrigger Binding="{Binding IsOverridden}" Value="True">
                            <Setter Property="Foreground" Value="#E9B578"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="覆盖" FontSize="10" Foreground="#E9B578"
                          Visibility="{Binding IsOverridden, Converter={StaticResource VisibleIf}}"/>
                      <TextBlock Text="{Binding Expression}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding ValueCount, StringFormat={}{0} 个参数}" Style="{StaticResource SectionLabel}" Margin="12,8"/>
              </Grid>
            </TabItem>
            <TabItem Header="IR" ToolTip="姿势、1D / 2D 混合与 Direct 节点">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox Margin="6,4,6,7" Tag="搜索树节点…" Text="{Binding IrFilter, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="搜索 Blend Tree 节点" ToolTip="按节点别名或规则 ID 筛选 root 下的树节点"/>
                <TreeView x:Name="NodeTree" Grid.Row="1" ItemsSource="{Binding IrTreeRoots}"
                    SelectedItemChanged="NodeTreeSelectionChanged" Background="{StaticResource SurfaceBrush}"
                    BorderThickness="0" ItemTemplate="{StaticResource IrTreeItemTemplate}"
                    AutomationProperties.Name="IR Blend Tree"/>
                <DockPanel Grid.Row="2" Margin="12,6">
                  <Button DockPanel.Dock="Right" Content="清理未引用" Click="ClearOrphanRulesClicked"
                      Visibility="{Binding HasOrphanIrNodes, Converter={StaticResource VisibleIf}}"
                      Padding="5,2" Margin="0" FontSize="10" ToolTip="移除不在 root Blend Tree 中的规则与未引用输出目标"/>
                  <TextBlock Text="{Binding VisibleIrNodeCount, StringFormat={}{0} 个树节点}" Style="{StaticResource SectionLabel}" Margin="0"/>
                </DockPanel>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"
          ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整结构列表宽度" AutomationProperties.Name="结构列表分隔条"/>
      <Grid Grid.Column="2" Visibility="{Binding ShowEditor, Converter={StaticResource VisibleIf}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="2,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding SelectionKind}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SelectionTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionTitle}">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Style.Triggers><DataTrigger Binding="{Binding SelectionOverridden}" Value="True">
                  <Setter Property="Foreground" Value="#E9B578"/>
                </DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="AddPoseRuleButton" Content="＋姿势" Click="AddPoseRuleClicked" IsEnabled="{Binding CanAddPoseRule}"
                Visibility="{Binding ShowIrGraphActions, Converter={StaticResource VisibleIf}}" Padding="4,3" Margin="1"
                FontSize="10" ToolTip="在当前 Blend Tree 下添加 Pose 子项"/>
            <Button x:Name="AddBlendRuleButton" Content="＋混合" Click="AddBlendRuleClicked" IsEnabled="{Binding CanAddBlendRule}"
                Visibility="{Binding ShowIrGraphActions, Converter={StaticResource VisibleIf}}" Padding="4,3" Margin="1"
                FontSize="10" ToolTip="嵌套当前维度的 Blend Tree"/>
            <Button x:Name="DeleteSelectedRuleButton" Content="删规则" Click="DeleteSelectedRuleClicked" IsEnabled="{Binding CanDeleteSelectedNode}"
                Visibility="{Binding ShowIrGraphActions, Converter={StaticResource VisibleIf}}" Padding="4,3" Margin="1"
                FontSize="10" ToolTip="删除当前规则"/>
            <Button x:Name="DeleteControlPointButton" Content="删点" Click="DeleteControlPointClicked"
                IsEnabled="{Binding CanDeleteSelectedControlPoint}" Visibility="{Binding ShowIrGraphActions, Converter={StaticResource VisibleIf}}"
                Padding="4,3" Margin="1" FontSize="10" ToolTip="删除混合图或子项列表中选中的控制点"/>
            <Button Content="适应视图" Click="FitClicked" IsEnabled="{Binding CanFitPlot}"
                Visibility="{Binding CanFitPlot, Converter={StaticResource VisibleIf}}" Padding="6,3" Margin="1"
                FontSize="10" ToolTip="将当前曲线或混合图完整显示 · 图中按 F"/>
          </WrapPanel>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding CenterTab}">
          <TabItem Header="曲线" ToolTip="编辑 value 输出响应曲线">
            <local:ParameterPlot x:Name="Plot" EditBeginning="PlotEditBeginning" EditChanged="PlotEditChanged"
                EditCommitted="PlotEditCommitted" EditCanceled="PlotEditCanceled" SelectionChanged="CurvePlotSelectionChanged" PreviewChanged="PlotPreviewChanged"
                IsEnabled="{Binding CanEditGraph}" ToolTip="{Binding PlotHint}" AutomationProperties.Name="Value 曲线编辑器"/>
          </TabItem>
          <TabItem Header="混合图" ToolTip="编辑 IR 的 1D / 2D 混合与姿势预览">
            <local:ParameterPlot x:Name="BlendPlot" EditBeginning="PlotEditBeginning" EditChanged="PlotEditChanged"
                EditCommitted="PlotEditCommitted" EditCanceled="PlotEditCanceled" SelectionChanged="BlendPlotSelectionChanged" PreviewChanged="PlotPreviewChanged"
                IsEnabled="{Binding CanEditGraph}" ToolTip="{Binding PlotHint}" AutomationProperties.Name="IR 混合图编辑器"/>
          </TabItem>
          <TabItem Header="实时输入" ToolTip="查看 VTS 原始输入；可切换实时输入、处理结果与输出页">
            <Grid/>
          </TabItem>
          <TabItem Header="JSON" ToolTip="直接编辑两份作品文本；应用时执行完整校验">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="2,2,2,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="应用" Click="ApplyTextClicked" IsEnabled="{Binding HasTextDraft}" ToolTip="校验并应用两份文本，形成一次可撤销编辑"/>
                  <Button Content="还原" Click="RevertTextClicked" IsEnabled="{Binding HasTextDraft}" ToolTip="放弃尚未应用的文本编辑"/>
                </StackPanel>
                <TextBlock Text="{Binding HeaderStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              </DockPanel>
              <TextBox Grid.Row="1" x:Name="ValueText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                  VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Value JSON" ToolTip="Value JSON"/>
              <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整两份 JSON 的高度比例"/>
              <TextBox Grid.Row="3" x:Name="IrText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                  VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="IR JSON" ToolTip="IR JSON"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"
          Visibility="{Binding ShowEditor, Converter={StaticResource VisibleIf}}"
          ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整图形与属性区域的比例" AutomationProperties.Name="属性区域分隔条"/>
      <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="5">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="属性" FontWeight="SemiBold" Margin="16,12,16,10"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PropertiesPanel" Margin="16,2,16,12" IsEnabled="{Binding CanEditProperties}">
              <TextBlock Text="名称" Style="{StaticResource SectionLabel}"/>
              <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" ToolTip="Value 参数名或 IR 节点的显示名称；点击应用属性提交"/>
              <StackPanel Visibility="{Binding HasValueSelection, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="表达式" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding DraftExpression, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono,Consolas" AcceptsReturn="True"
                    TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" Margin="0,0,0,12" ToolTip="表达式先于响应曲线执行；空表达式使用默认值"/>
              </StackPanel>
              <StackPanel Visibility="{Binding HasAxisX, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="X 参数" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding DraftAxisX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" ToolTip="绑定 IR parameters 中声明的参数名"/>
              </StackPanel>
              <StackPanel Visibility="{Binding HasAxisY, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="Y 参数" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding DraftAxisY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" ToolTip="二维混合的第二参数轴"/>
              </StackPanel>
              <Button Content="应用属性" Click="ApplyPropertiesClicked" IsEnabled="{Binding HasPropertyDraft}" HorizontalAlignment="Left" Margin="0,0,0,22" ToolTip="校验并提交名称、表达式或参数轴，支持撤销；切换选择时也会自动提交有效编辑"/>
              <StackPanel Visibility="{Binding HasValueSelection, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <DockPanel Margin="0,0,0,9">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="＋" Click="AddCurvePointClicked" ToolTip="在最大间隔中添加曲线点" AutomationProperties.Name="添加曲线点" Padding="8,2"/>
                    <Button Content="－" Click="DeleteCurvePointClicked" ToolTip="删除选中的曲线点；至少保留两个" AutomationProperties.Name="删除曲线点" Padding="8,2" Margin="0"/>
                  </StackPanel>
                  <TextBlock Text="响应曲线" FontWeight="SemiBold"/>
                </DockPanel>
                <DataGrid x:Name="CurveGrid" ItemsSource="{Binding CurveRows}" CellEditEnding="CurveCellEditEnding" SelectionChanged="CurveSelectionChanged"
                    CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="130" MaxHeight="360"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ToolTip="双击数值或按 F2 编辑；切线 Infinity 表示阶跃">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="输入" Binding="{Binding Time}" SortMemberPath="Time" Width="*"/>
                    <DataGridTextColumn Header="输出" Binding="{Binding Value}" SortMemberPath="Value" Width="*"/>
                    <DataGridTextColumn Header="入切线" Binding="{Binding InTangent}" SortMemberPath="InTangent" Width="*"/>
                    <DataGridTextColumn Header="出切线" Binding="{Binding OutTangent}" SortMemberPath="OutTangent" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Margin="0,14,0,0">
                  <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button x:Name="AddSmoothModifierButton" Content="＋平滑" Tag="smooth" Click="AddModifierClicked" Padding="5,2" ToolTip="添加平滑修饰器"/>
                      <Button x:Name="AddDelayModifierButton" Content="＋延迟" Tag="delay" Click="AddModifierClicked" Padding="5,2" ToolTip="添加延迟修饰器"/>
                      <Button x:Name="AddStepsModifierButton" Content="＋维持" Tag="steps" Click="AddModifierClicked" Padding="5,2" Margin="0" ToolTip="添加维持步骤修饰器"/>
                    </StackPanel>
                    <TextBlock Text="规则约束 · 修饰器链" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ListBox x:Name="ModifierList" ItemsSource="{Binding ModifierRows}"
                      SelectedIndex="{Binding SelectedModifierIndex, Mode=TwoWay}" MinHeight="36" MaxHeight="108"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="有序修饰器链">
                    <ListBox.ItemTemplate><DataTemplate>
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="尚未添加修饰器" FontSize="10" Foreground="{StaticResource MutedBrush}"
                      HorizontalAlignment="Center" Margin="0,6"
                      Visibility="{Binding ModifierEmptyVisibility}"/>
                  <Grid Margin="0,5,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ModifierOrderSummary}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    <Button x:Name="MoveModifierUpButton" Grid.Column="1" Content="↑" Tag="up" Click="MoveModifierClicked" Padding="5,1" Margin="0,0,3,0"
                        IsEnabled="{Binding CanMoveModifierUp}" ToolTip="上移修饰器"/>
                    <Button x:Name="MoveModifierDownButton" Grid.Column="2" Content="↓" Tag="down" Click="MoveModifierClicked" Padding="5,1" Margin="0,0,3,0"
                        IsEnabled="{Binding CanMoveModifierDown}" ToolTip="下移修饰器"/>
                    <Button x:Name="DeleteModifierButton" Grid.Column="3" Content="×" Click="DeleteModifierClicked" Padding="5,1" Margin="0"
                        IsEnabled="{Binding HasSelectedModifier}" ToolTip="删除所选修饰器"/>
                  </Grid>
                  <Grid Visibility="{Binding SelectedModifierVisibility}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                      <ComboBox x:Name="ModifierKindCombo" ItemsSource="{Binding ModifierKindOptions}"
                          SelectedItem="{Binding ModifierKindDraft, Mode=OneWay}" SelectionChanged="ModifierKindChanged"
                          MinHeight="28" ToolTip="选择此步骤链中的变换类型"/>
                      <TextBlock Grid.Column="1" Text="秒" Foreground="{StaticResource MutedBrush}" Margin="8,0"
                          Visibility="{Binding SelectedModifierSecondsVisibility}"/>
                      <TextBox Grid.Column="2" Text="{Binding ModifierSecondsDraft, UpdateSourceTrigger=PropertyChanged}"
                          LostFocus="ModifierSecondsLostFocus" Visibility="{Binding SelectedModifierSecondsVisibility}"
                          AutomationProperties.Name="修饰器时长" ToolTip="平滑或延迟时长，单位秒"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Visibility="{Binding SelectedModifierStepsVisibility}">
                      <DockPanel Margin="0,0,0,5">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Content="＋" Click="AddModifierStepClicked" Padding="5,1" ToolTip="添加维持步骤"/>
                          <Button Content="×" Click="DeleteModifierStepClicked" Padding="5,1" Margin="0"
                              IsEnabled="{Binding CanDeleteModifierStep}" ToolTip="删除所选维持步骤"/>
                        </StackPanel>
                        <TextBlock Text="维持步骤" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                      </DockPanel>
                      <DataGrid x:Name="ModifierStepsGrid" ItemsSource="{Binding ModifierStepRows}"
                          SelectedIndex="{Binding SelectedModifierStepIndex, Mode=TwoWay}"
                          CellEditEnding="ModifierStepCellEditEnding" CanUserSortColumns="False"
                          CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                          MinHeight="56" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ToolTip="按触发值严格递增；保持、回差和进入/退出时间均以秒计">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="触发" Binding="{Binding Trigger}" SortMemberPath="Trigger" Width="*"/>
                          <DataGridTextColumn Header="目标" Binding="{Binding Target}" SortMemberPath="Target" Width="*"/>
                          <DataGridTextColumn Header="保持" Binding="{Binding Hold}" SortMemberPath="Hold" Width="*"/>
                          <DataGridTextColumn Header="回差" Binding="{Binding Threshold}" SortMemberPath="Threshold" Width="*"/>
                          <DataGridTextColumn Header="进入" Binding="{Binding EnterSeconds}" SortMemberPath="EnterSeconds" Width="*"/>
                          <DataGridTextColumn Header="退出" Binding="{Binding ExitSeconds}" SortMemberPath="ExitSeconds" Width="*"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
              <StackPanel Visibility="{Binding HasPoseSelection, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <DockPanel Margin="0,0,0,8">
                  <Button x:Name="DeletePoseWeightButton" DockPanel.Dock="Right" Content="删除输出" Click="DeletePoseWeightClicked"
                      IsEnabled="{Binding CanDeletePoseWeight}" Padding="6,2" Margin="0"
                      ToolTip="只删除此 Pose 里选中的已存目标"/>
                  <TextBlock Text="Pose 输出" FontWeight="SemiBold"/>
                </DockPanel>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding PoseTargetDraft, UpdateSourceTrigger=PropertyChanged}"
                      Tag="目标 ID（可直接输入）" AutomationProperties.Name="Pose 输出目标 ID"/>
                  <TextBox Grid.Column="1" Text="{Binding PoseWeightDraft, UpdateSourceTrigger=PropertyChanged}"
                      Margin="6,0,0,0" AutomationProperties.Name="Pose 输出权重"/>
                  <Button x:Name="AddPoseWeightButton" Grid.Column="2" Content="添加" Click="AddPoseWeightClicked" Padding="8,3"
                      Margin="6,0,0,0" ToolTip="保存这条 Pose 目标权重"/>
                </Grid>
                <DataGrid x:Name="WeightsGrid" ItemsSource="{Binding InspectorWeights}"
                    SelectedIndex="{Binding SelectedPoseWeightIndex, Mode=TwoWay}"
                    CellEditEnding="WeightsCellEditEnding" CanUserSortColumns="False" CanUserReorderColumns="False"
                    SelectionMode="Single" SelectionUnit="FullRow" MinHeight="64" MaxHeight="220"
                    ToolTip="这里只显示此 Pose 中已保存的目标；目标 ID 可直接编辑">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="目标 ID" Binding="{Binding TargetId, UpdateSourceTrigger=LostFocus}"
                        SortMemberPath="TargetId" Width="*"/>
                    <DataGridTextColumn Header="权重" Binding="{Binding Value}" SortMemberPath="Value" Width="90"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding PoseWeightEmptyText}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                    HorizontalAlignment="Center" Margin="0,8,0,0"
                    Visibility="{Binding PoseWeightEmptyVisibility}"/>
              </StackPanel>
              <StackPanel Visibility="{Binding HasAxisX, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <DockPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding BlendChildrenTitle}" FontWeight="SemiBold"/>
                </DockPanel>
                <DataGrid x:Name="ControlPointGrid" ItemsSource="{Binding ControlPoints}"
                    SelectedIndex="{Binding SelectedControlPointIndex, Mode=TwoWay}"
                    CellEditEnding="ControlPointCellEditEnding" SelectionChanged="ControlPointSelectionChanged"
                    CanUserSortColumns="False" CanUserReorderColumns="False"
                    SelectionMode="Single" SelectionUnit="FullRow" MinHeight="100" MaxHeight="320"
                    ToolTip="列表就是此混合树实际保存的子项；姿势名显示别名，X/Y 或阈值可编辑">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="姿势别名" Binding="{Binding ChildId}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn x:Name="ControlPointXColumn" Header="X" Binding="{Binding X}" SortMemberPath="X" Width="85"/>
                    <DataGridTextColumn x:Name="ControlPointYColumn" Header="Y" Binding="{Binding Y}" SortMemberPath="Y" Width="85"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Visibility="{Binding HasWeightSelection, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <TextBlock Text="{Binding WeightSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid x:Name="DirectWeightsGrid" ItemsSource="{Binding InspectorWeights}" CellEditEnding="WeightsCellEditEnding" CanUserSortColumns="False"
                    CanUserReorderColumns="False" MinHeight="150" MaxHeight="420" ToolTip="双击数值或按 F2 编辑；每次有效修改都可撤销">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="目标 / 子项" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="数值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Background="#302722" Padding="12" Margin="10,0,10,10">
            <Border.Style><Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers><DataTrigger Binding="{Binding Diagnostics}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <TextBlock Text="{Binding Diagnostics}" Foreground="#F1B17E" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>
      <Grid x:Name="MonitorWorkspace" Grid.ColumnSpan="5" Panel.ZIndex="10" Background="{StaticResource WindowBrush}"
          Visibility="{Binding MonitorWorkspaceVisibility}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Content="曲线" Click="MonitorNavigationClicked" Tag="0" Padding="8,4" ToolTip="打开 Value 曲线编辑页"/>
            <Button Content="混合图" Click="MonitorNavigationClicked" Tag="1" Padding="8,4" ToolTip="打开 IR 混合图编辑页"/>
            <ToggleButton x:Name="RawMonitorTab" Content="实时输入" IsChecked="{Binding IsRawMonitorTab, Mode=OneWay}"
                Click="MonitorStageNavigationClicked" Tag="0" Padding="8,4" ToolTip="查看 VTS 原始参数输入"/>
            <ToggleButton x:Name="ValueMonitorTab" Content="实时处理" IsChecked="{Binding IsValueMonitorTab, Mode=OneWay}"
                Click="MonitorStageNavigationClicked" Tag="1" Padding="8,4" ToolTip="查看 Value 规则处理结果"/>
            <ToggleButton x:Name="IrMonitorTab" Content="实时输出" IsChecked="{Binding IsIrMonitorTab, Mode=OneWay}"
                Click="MonitorStageNavigationClicked" Tag="2" Padding="8,4" ToolTip="查看 IR 最终形态键权重"/>
            <Button Content="JSON" Click="MonitorNavigationClicked" Tag="3" Padding="8,4" ToolTip="打开 JSON 文本编辑页"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding MonitorStatus}" Foreground="{StaticResource MutedBrush}"
              FontSize="11" Margin="12,0" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="MonitorSearchBox" Grid.Column="2" Width="220" Tag="搜索参数名称或 ID…"
              Text="{Binding MonitorFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索实时参数"
              ToolTip="同步筛选原始输入、Value 输出和 IR 权重"/>
        </Grid>
        <Border x:Name="RawMonitorPage" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8"
            Visibility="{Binding IsRawMonitorTab, Converter={StaticResource VisibleIf}}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="VTS · 原始通道" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding RawMonitorCount, StringFormat={}{0} 路}"
                    Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="清除" Tag="Raw" Click="ClearMonitorOverridesClicked" Padding="5,2" Margin="0"
                    FontSize="10" Visibility="{Binding HasRawMonitorOverrides, Converter={StaticResource VisibleIf}}"
                    ToolTip="恢复本组全部实时输入"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RawMonitorItems" ItemsSource="{Binding RawMonitorView}"
                    ItemTemplate="{StaticResource MonitorParameterTemplate}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="{Binding RawMonitorEmptyText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding RawMonitorEmptyVisibility}"/>
            </Grid>
        </Border>
        <Border x:Name="ValueMonitorPage" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8"
            Visibility="{Binding IsValueMonitorTab, Converter={StaticResource VisibleIf}}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Value · 规则处理结果" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding ValueMonitorCount, StringFormat={}{0} 项}"
                    Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="清除" Tag="Value" Click="ClearMonitorOverridesClicked" Padding="5,2" Margin="0"
                    FontSize="10" Visibility="{Binding HasValueMonitorOverrides, Converter={StaticResource VisibleIf}}"
                    ToolTip="恢复本组全部实时 value 结果"/>
              </Grid>
              <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="ValueMonitorItems" ItemsSource="{Binding ValueMonitorView}"
                      ItemTemplate="{StaticResource MonitorParameterTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding ValueMonitorEmptyText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ValueMonitorEmptyVisibility}"/>
              </Grid>
            </Grid>
        </Border>
        <Border x:Name="IrMonitorPage" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8"
            Visibility="{Binding IsIrMonitorTab, Converter={StaticResource VisibleIf}}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="IR · 最终权重输出" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding IrMonitorCount, StringFormat={}{0} 个目标}"
                    Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="清除" Tag="Ir" Click="ClearMonitorOverridesClicked" Padding="5,2" Margin="0"
                    FontSize="10" Visibility="{Binding HasIrMonitorOverrides, Converter={StaticResource VisibleIf}}"
                    ToolTip="恢复本组全部实时 IR 权重"/>
              </Grid>
              <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="IrMonitorItems" ItemsSource="{Binding IrMonitorView}"
                      ItemTemplate="{StaticResource MonitorParameterTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding IrMonitorEmptyText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IrMonitorEmptyVisibility}"/>
              </Grid>
            </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="16,6" Background="{StaticResource SurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding InputStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding OutputStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="16,0" ToolTip="{Binding OutputStatus}"/>
        <Button Grid.Column="2" Content="{Binding EditorVisibilityAction}" Click="ToggleEditorClicked" Padding="6,1" Margin="0,0,8,0" FontSize="10"
            ToolTip="收起中间图形与 JSON 区，将空间留给属性；再次展开会恢复宽度比例"/>
        <Button Grid.Column="3" Content="重置布局" Click="ResetLayoutClicked" Padding="6,1" Margin="0" FontSize="10" ToolTip="恢复默认宽度；拖动后的布局会自动记住"/>
      </Grid>
    </Border>
  </Grid>
</Window>
