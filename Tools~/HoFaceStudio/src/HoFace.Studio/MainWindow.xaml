<Window x:Class="HoFace.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HoFace.Studio"
    Title="HoFaceStudio" Width="1380" Height="860" MinWidth="1024" MinHeight="640"
    WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
    Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf"/>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Open" Executed="OpenExecuted"/>
    <CommandBinding Command="ApplicationCommands.Save" Executed="SaveExecuted" CanExecute="SaveCanExecute"/>
    <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoExecuted" CanExecute="UndoCanExecute"/>
    <CommandBinding Command="ApplicationCommands.Redo" Executed="RedoExecuted" CanExecute="RedoCanExecute"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.Open" Modifiers="Control" Key="O"/>
    <KeyBinding Command="ApplicationCommands.Save" Modifiers="Control" Key="S"/>
    <KeyBinding Command="ApplicationCommands.Undo" Modifiers="Control" Key="Z"/>
    <KeyBinding Command="ApplicationCommands.Redo" Modifiers="Control" Key="Y"/>
    <KeyBinding Command="ApplicationCommands.Redo" Modifiers="Control+Shift" Key="Z"/>
  </Window.InputBindings>
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="HoFaceStudio" FontSize="15" FontWeight="SemiBold" Margin="0,0,22,0"/>
          <Button Content="打开" Command="ApplicationCommands.Open" ToolTip="打开一对 value + IR 文件 · Ctrl+O"/>
          <Button Content="保存" Command="ApplicationCommands.Save" ToolTip="保存作品 · Ctrl+S"/>
          <Button Content="撤销" Command="ApplicationCommands.Undo" ToolTip="撤销一次编辑，保持当前选择 · Ctrl+Z"/>
          <Button Content="重做" Command="ApplicationCommands.Redo" ToolTip="重做 · Ctrl+Y / Ctrl+Shift+Z"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,16,0">
          <TextBlock Text="{Binding DocumentName}" MaxWidth="230" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValuePath}"/>
          <TextBlock Text="{Binding HeaderStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0"/>
        </StackPanel>
        <ToggleButton Grid.Column="2" Content="文件信息" IsChecked="{Binding ShowFiles}" ToolTip="查看当前文件的完整路径"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid Margin="16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Mode}" SelectionChanged="ModeChanged"
              ToolTip="Blender：外部求值并发送最终权重。Unity：只转发原始输入，由 Unity 自行求值。">
            <ComboBoxItem Tag="Preview">Blender · 权重预览</ComboBoxItem>
            <ComboBoxItem Tag="RawForward">Unity · 原始输入</ComboBoxItem>
          </ComboBox>
          <Button Grid.Column="1" Content="{Binding ConnectionAction}" Click="ConnectionToggleClicked" Margin="12,0,7,0"
              IsEnabled="{Binding HasDocument}" ToolTip="连接或停止 VTS iPhone 输入"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="{Binding PreviewAction}" Click="PreviewToggleClicked" IsEnabled="{Binding CanPreview}"
                ToolTip="启停发往 Blender 的最终权重；仅在 Blender 模式可用"/>
            <Button Content="恢复实时" Click="ClearManualPreviewClicked" Visibility="{Binding HasManualPreview, Converter={StaticResource VisibleIf}}"
                ToolTip="取消临时参数覆盖；未连接实时输入时释放预览权重"/>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding LiveStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"
              Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputStatus}"/>
          <ToggleButton Grid.Column="4" Content="连接与回放" IsChecked="{Binding ShowConnection}" ToolTip="手机地址、端口、录制与回放设置"/>
        </Grid>
        <Border Visibility="{Binding ShowFiles, Converter={StaticResource VisibleIf}}" Padding="16,4,16,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="value" Foreground="{StaticResource MutedBrush}"/>
            <TextBox Grid.Column="1" Text="{Binding ValuePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding ValuePath}"/>
            <TextBlock Grid.Row="1" Text="IR" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IrPath, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0" ToolTip="{Binding IrPath}"/>
          </Grid>
        </Border>
        <Border Visibility="{Binding ShowConnection, Converter={StaticResource VisibleIf}}" Padding="16,4,16,12">
          <StackPanel>
            <WrapPanel>
              <TextBlock Text="手机 IP" Margin="0,0,8,0"/>
              <TextBox Width="145" Text="{Binding PhoneIp, UpdateSourceTrigger=PropertyChanged}" ToolTip="运行 VTS iPhone 的手机局域网 IPv4 地址"/>
              <TextBlock Text="手机端口" Margin="16,0,8,0"/>
              <TextBox Width="75" Text="{Binding PhonePort, UpdateSourceTrigger=PropertyChanged}" ToolTip="手机 VTS 监听端口，默认 21412"/>
              <TextBlock Text="本机端口" Margin="16,0,8,0"/>
              <TextBox Width="75" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="本机接收端口，默认 21413；需与其他接收器错开"/>
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="{Binding RecordAction}" Click="RecordToggleClicked" IsEnabled="{Binding HasDocument}" ToolTip="将原始输入记录为 JSONL；录制文件与作品分开保存"/>
              <Button Content="打开录制" Click="OpenReplayClicked" IsEnabled="{Binding HasDocument}" ToolTip="选择本地 JSONL 原始帧录制"/>
              <Button Content="{Binding ReplayAction}" Click="ReplayToggleClicked" IsEnabled="{Binding ReplayLoaded}" ToolTip="播放或暂停已打开的录制"/>
              <TextBlock Text="{Binding RecordingStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <Grid x:Name="Workspace" Grid.Row="2" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="StructureColumn" Width="240" MinWidth="180" MaxWidth="500"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition x:Name="PlotColumn" Width="0.95*" MinWidth="280"/>
        <ColumnDefinition x:Name="EditorSplitterColumn" Width="8"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="1.05*" MinWidth="320"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="5">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="作品结构" FontWeight="SemiBold" Margin="14,12,14,9"/>
          <TabControl Grid.Row="1" SelectedIndex="{Binding StructureTab}" BorderThickness="0">
            <TabItem Header="Value" ToolTip="输入处理后的输出参数与响应曲线">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox Margin="6,4,6,9" Tag="筛选参数…" Text="{Binding ValueFilter, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="筛选 Value 参数" ToolTip="筛选参数名称或表达式；筛选不会清除当前编辑项"/>
                <ListBox Grid.Row="1" x:Name="ValueList" ItemsSource="{Binding ValueRows}" SelectedItem="{Binding SelectedValueRow}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel ToolTip="{Binding Display}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Expression}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding ValueCount, StringFormat={}{0} 个参数}" Style="{StaticResource SectionLabel}" Margin="12,8"/>
              </Grid>
            </TabItem>
            <TabItem Header="IR" ToolTip="姿势、1D / 2D 混合与 Direct 节点">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox Margin="6,4,6,9" Tag="筛选节点…" Text="{Binding IrFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="筛选 IR 节点" ToolTip="筛选节点名称、ID、类型或参数轴"/>
                <ListBox Grid.Row="1" x:Name="NodeList" ItemsSource="{Binding NodeRows}" SelectedItem="{Binding SelectedNodeRow}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel ToolTip="{Binding Display}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{Binding NodeCount, StringFormat={}{0} 个节点}" Style="{StaticResource SectionLabel}" Margin="12,8"/>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"
          ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整结构列表宽度" AutomationProperties.Name="结构列表分隔条"/>
      <Grid Grid.Column="2" Visibility="{Binding ShowEditor, Converter={StaticResource VisibleIf}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="2,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding SelectionKind}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SelectionTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionTitle}"/>
          </StackPanel>
          <Button Grid.Column="1" Content="适应视图" Click="FitClicked" ToolTip="将曲线或控制点完整显示 · 图中按 F"/>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding CenterTab}">
          <TabItem Header="曲线 / 混合" ToolTip="{Binding PlotHint}">
            <local:ParameterPlot x:Name="Plot" EditBeginning="PlotEditBeginning" EditChanged="PlotEditChanged"
                EditCommitted="PlotEditCommitted" EditCanceled="PlotEditCanceled" SelectionChanged="PlotSelectionChanged" PreviewChanged="PlotPreviewChanged"
                IsEnabled="{Binding CanEditGraph}" ToolTip="{Binding PlotHint}" AutomationProperties.Name="曲线与混合图编辑器"/>
          </TabItem>
          <TabItem Header="JSON" ToolTip="直接编辑作品文本；应用时执行完整校验">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="2,2,2,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="应用" Click="ApplyTextClicked" IsEnabled="{Binding HasTextDraft}" ToolTip="校验并应用两份文本，形成一次可撤销编辑"/>
                  <Button Content="还原" Click="RevertTextClicked" IsEnabled="{Binding HasTextDraft}" ToolTip="放弃尚未应用的文本编辑"/>
                </StackPanel>
                <TextBlock Text="{Binding HeaderStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              </DockPanel>
              <TextBox Grid.Row="1" x:Name="ValueText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                  VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Value JSON" ToolTip="Value JSON"/>
              <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整两份 JSON 的高度比例"/>
              <TextBox Grid.Row="3" x:Name="IrText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                  VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="IR JSON" ToolTip="IR JSON"/>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"
          Visibility="{Binding ShowEditor, Converter={StaticResource VisibleIf}}"
          ResizeBehavior="PreviousAndNext" ShowsPreview="True" ToolTip="拖动调整图形与属性区域的比例" AutomationProperties.Name="属性区域分隔条"/>
      <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="5">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="属性" FontWeight="SemiBold" Margin="16,12,16,10"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PropertiesPanel" Margin="16,2,16,12" IsEnabled="{Binding CanEditProperties}">
              <TextBlock Text="名称" Style="{StaticResource SectionLabel}"/>
              <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" ToolTip="Value 参数名或 IR 节点的显示名称；点击应用属性提交"/>
              <StackPanel Visibility="{Binding HasValueSelection, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="表达式" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding DraftExpression, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono,Consolas" AcceptsReturn="True"
                    TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" Margin="0,0,0,12" ToolTip="表达式先于响应曲线执行；空表达式使用默认值"/>
              </StackPanel>
              <StackPanel Visibility="{Binding HasAxisX, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="X 参数" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding DraftAxisX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" ToolTip="绑定 IR parameters 中声明的参数名"/>
              </StackPanel>
              <StackPanel Visibility="{Binding HasAxisY, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="Y 参数" Style="{StaticResource SectionLabel}"/>
                <TextBox Text="{Binding DraftAxisY, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" ToolTip="二维混合的第二参数轴"/>
              </StackPanel>
              <Button Content="应用属性" Click="ApplyPropertiesClicked" IsEnabled="{Binding HasPropertyDraft}" HorizontalAlignment="Left" Margin="0,0,0,22" ToolTip="校验并提交名称、表达式或参数轴，支持撤销；切换选择时也会自动提交有效编辑"/>
              <StackPanel Visibility="{Binding HasValueSelection, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <DockPanel Margin="0,0,0,9">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="＋" Click="AddCurvePointClicked" ToolTip="在最大间隔中添加曲线点" AutomationProperties.Name="添加曲线点" Padding="8,2"/>
                    <Button Content="－" Click="DeleteCurvePointClicked" ToolTip="删除选中的曲线点；至少保留两个" AutomationProperties.Name="删除曲线点" Padding="8,2" Margin="0"/>
                  </StackPanel>
                  <TextBlock Text="响应曲线" FontWeight="SemiBold"/>
                </DockPanel>
                <DataGrid x:Name="CurveGrid" ItemsSource="{Binding CurveRows}" CellEditEnding="CurveCellEditEnding" SelectionChanged="CurveSelectionChanged"
                    CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="130" MaxHeight="360"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ToolTip="双击数值或按 F2 编辑；切线 Infinity 表示阶跃">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="输入" Binding="{Binding Time}" SortMemberPath="Time" Width="*"/>
                    <DataGridTextColumn Header="输出" Binding="{Binding Value}" SortMemberPath="Value" Width="*"/>
                    <DataGridTextColumn Header="入切线" Binding="{Binding InTangent}" SortMemberPath="InTangent" Width="*"/>
                    <DataGridTextColumn Header="出切线" Binding="{Binding OutTangent}" SortMemberPath="OutTangent" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Visibility="{Binding HasAxisX, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <TextBlock Text="混合控制点" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid x:Name="ControlPointGrid" ItemsSource="{Binding ControlPoints}" CellEditEnding="ControlPointCellEditEnding"
                    SelectionChanged="ControlPointSelectionChanged" CanUserSortColumns="False" CanUserReorderColumns="False"
                    SelectionMode="Single" SelectionUnit="FullRow" MinHeight="150" MaxHeight="420" ToolTip="选中行与图中的控制点联动；双击 X / Y 或阈值进行精确编辑">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="姿势" Binding="{Binding ChildId}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn x:Name="ControlPointXColumn" Header="X" Binding="{Binding X}" SortMemberPath="X" Width="85"/>
                    <DataGridTextColumn x:Name="ControlPointYColumn" Header="Y" Binding="{Binding Y}" SortMemberPath="Y" Width="85"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Visibility="{Binding HasWeightSelection, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEditGraph}">
                <TextBlock Text="{Binding WeightSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid x:Name="WeightsGrid" ItemsSource="{Binding InspectorWeights}" CellEditEnding="WeightsCellEditEnding" CanUserSortColumns="False"
                    CanUserReorderColumns="False" MinHeight="150" MaxHeight="420" ToolTip="双击数值或按 F2 编辑；每次有效修改都可撤销">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="目标 / 子项" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="数值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Background="#302722" Padding="12" Margin="10,0,10,10">
            <Border.Style><Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers><DataTrigger Binding="{Binding Diagnostics}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <TextBlock Text="{Binding Diagnostics}" Foreground="#F1B17E" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="16,6" Background="{StaticResource SurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding InputStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding OutputStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="16,0" ToolTip="{Binding OutputStatus}"/>
        <Button Grid.Column="2" Content="{Binding EditorVisibilityAction}" Click="ToggleEditorClicked" Padding="6,1" Margin="0,0,8,0" FontSize="10"
            ToolTip="收起中间图形与 JSON 区，将空间留给属性；再次展开会恢复宽度比例"/>
        <Button Grid.Column="3" Content="重置布局" Click="ResetLayoutClicked" Padding="6,1" Margin="0" FontSize="10" ToolTip="恢复默认宽度；拖动后的布局会自动记住"/>
      </Grid>
    </Border>
  </Grid>
</Window>
