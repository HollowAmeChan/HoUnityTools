<Window x:Class="HoFace.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HoFace.Studio"
    Title="HoFaceStudio" Width="1440" Height="900" MinWidth="1000" MinHeight="620"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource WindowBrush}"
    Foreground="{StaticResource TextBrush}">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Open" Executed="OpenExecuted"/>
    <CommandBinding Command="ApplicationCommands.Save" Executed="SaveExecuted" CanExecute="SaveCanExecute"/>
    <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoExecuted" CanExecute="UndoCanExecute"/>
    <CommandBinding Command="ApplicationCommands.Redo" Executed="RedoExecuted" CanExecute="RedoCanExecute"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="ApplicationCommands.Open" Modifiers="Control" Key="O"/>
    <KeyBinding Command="ApplicationCommands.Save" Modifiers="Control" Key="S"/>
    <KeyBinding Command="ApplicationCommands.Undo" Modifiers="Control" Key="Z"/>
    <KeyBinding Command="ApplicationCommands.Redo" Modifiers="Control" Key="Y"/>
  </Window.InputBindings>
  <DockPanel Background="{StaticResource WindowBrush}">
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="打开 value + IR" Click="OpenClicked"/>
        <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding HeaderStatus}"/>
        <ComboBox Grid.Column="2" Width="180" SelectedValuePath="Tag" SelectedValue="{Binding Mode}" SelectionChanged="ModeChanged">
          <ComboBoxItem Tag="Preview">Blender · 表情权重</ComboBoxItem>
          <ComboBoxItem Tag="RawForward">Unity · Raw 中间数据</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Column="3" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}" Text="Ctrl+S 保存 · Ctrl+Z 撤销 · Ctrl+Y 重做"/>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
          <Label Content="手机 IP"/>
          <TextBox Width="130" Text="{Binding PhoneIp, UpdateSourceTrigger=PropertyChanged}"/>
          <Label Content="手机端口" Margin="12,0,0,0"/>
          <TextBox Width="66" Text="{Binding PhonePort, UpdateSourceTrigger=PropertyChanged}"/>
          <Label Content="本机端口" Margin="12,0,0,0"/>
          <TextBox Width="66" Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Content="连接 VTS" Click="ConnectClicked" Margin="14,0,0,0"/>
          <Button Content="停止" Click="StopClicked"/>
          <Button Content="预览发送" Click="PreviewClicked"/>
          <Button Content="停止预览" Click="StopPreviewClicked"/>
          <TextBlock Text="{Binding LiveStatus}" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding Status}"/>
      <Separator/>
      <StatusBarItem Content="{Binding InputStatus}"/>
      <Separator/>
      <StatusBarItem Content="{Binding TargetStatus}"/>
    </StatusBar>
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="value 文件" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" Text="{Binding ValuePath, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Column="2" Text="IR 文件" Margin="16,0,8,0"/>
          <TextBox Grid.Column="3" Text="{Binding IrPath, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Column="4" Text="预览目标" Margin="16,0,8,0"/>
          <TextBox Grid.Column="5" Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="作品结构" Margin="0,0,10,0">
          <TabControl>
            <TabItem Header="value">
              <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,7" Text="{Binding ValueFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选参数或表达式"/>
                <ListBox ItemsSource="{Binding ValueRows}" SelectedItem="{Binding SelectedValueRow}" DisplayMemberPath="Display"/>
              </DockPanel>
            </TabItem>
            <TabItem Header="IR">
              <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,7" Text="{Binding IrFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选节点名称、类型或参数轴"/>
                <ListBox ItemsSource="{Binding NodeRows}" SelectedItem="{Binding SelectedNodeRow}" DisplayMemberPath="Display"/>
              </DockPanel>
            </TabItem>
          </TabControl>
        </GroupBox>
        <Grid Grid.Column="1" Margin="0,0,10,0">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TabControl SelectedIndex="{Binding CenterTab}">
            <TabItem Header="曲线 / 混合图">
              <local:ParameterPlot x:Name="Plot" EditBeginning="PlotEditBeginning" EditChanged="PlotEditChanged"
                  EditCommitted="PlotEditCommitted" SelectionChanged="PlotSelectionChanged"
                  PreviewChanged="PlotPreviewChanged"/>
            </TabItem>
            <TabItem Header="JSON 文本">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="ValueText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                    FontFamily="Cascadia Mono" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBox x:Name="IrText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                    FontFamily="Cascadia Mono" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </TabItem>
          </TabControl>
          <TextBlock Grid.Row="1" Margin="2,7,0,0" Text="{Binding PlotHint}" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <GroupBox Grid.Column="2" Header="{Binding InspectorTitle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding InspectorSummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <TextBlock Text="名称 / 类型" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Text="{Binding InspectorName}" IsReadOnly="True" Margin="0,3,0,9"/>
              <TextBlock Text="表达式 / 参数轴" Foreground="{StaticResource MutedBrush}"/>
              <TextBox Text="{Binding InspectorExpression}" IsReadOnly="True" Margin="0,3,0,9"/>
              <DataGrid ItemsSource="{Binding InspectorWeights}" CellEditEnding="WeightsCellEditEnding"
                  Height="240" Margin="0,3,0,9">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="目标 / 参数" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                  <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Foreground="#F1B17E"/>
            </StackPanel>
          </ScrollViewer>
        </GroupBox>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
