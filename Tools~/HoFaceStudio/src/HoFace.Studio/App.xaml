<Application x:Class="HoFace.Studio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#20262F"/>
    <SolidColorBrush x:Key="InkBrush" Color="#E5EAF0"/>
    <Style TargetType="Window">
      <Setter Property="Background" Value="#171C23"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Background" Value="#303B49"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="#465465"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#151B22"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="#465465"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#395D83"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="MinHeight" Value="29"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#20262F"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#344E69"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#1C232C"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="RowBackground" Value="#202833"/>
      <Setter Property="AlternatingRowBackground" Value="#252E3A"/>
      <Setter Property="BorderBrush" Value="#354251"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#303A47"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="RowHeight" Value="30"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#303B49"/>
      <Setter Property="Foreground" Value="#CBD5E0"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#20262F"/>
      <Setter Property="BorderBrush" Value="#354251"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="18,7"/>
      <Setter Property="Background" Value="#27313D"/>
      <Setter Property="Foreground" Value="#CBD5E0"/>
      <Setter Property="BorderBrush" Value="#354251"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Background" Value="#20262F"/>
      <Setter Property="Foreground" Value="#AEBFD0"/>
      <Setter Property="BorderBrush" Value="#354251"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="#20262F"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="TabPanel">
      <Setter Property="Background" Value="#20262F"/>
    </Style>
  </Application.Resources>
</Application>
