<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>HoFaceStudio</AssemblyName>
    <RootNamespace>HoFace.Studio</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shared/AutomationContract.cs" Link="AutomationContract.cs" />
    <ProjectReference Include="../HoFace.Core/HoFace.Core.csproj" />
    <ProjectReference Include="../HoFace.Transport/HoFace.Transport.csproj" />
    <Content Include="../../samples/*.json" Link="samples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
